{
	"name": "lafka-plugin",
	"version": "10.4.0",
	"private": true,
	"description": "Lafka Companion Plugin",
	"scripts": {
		"lint:js": "eslint . --max-warnings=0 --cache --cache-location .eslintcache",
		"lint:js:fix": "eslint . --fix --cache --cache-location .eslintcache",
		"lint:css": "stylelint '**/*.css' --max-warnings=0 --cache --cache-location .stylelintcache",
		"lint:css:fix": "stylelint '**/*.css' --fix --cache --cache-location .stylelintcache",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
		"build": "node scripts/build-assets.mjs",
		"i18n:pot": "../local-env/lafka wp i18n make-pot wp-content/plugins/lafka-plugin wp-content/plugins/lafka-plugin/languages/lafka-plugin.pot --domain=lafka-plugin --exclude=scripts,node_modules,vendor",
		"sync-version": "node scripts/sync-version.mjs",
		"check-version": "node scripts/sync-version.mjs --check",
		"version": "node scripts/sync-version.mjs --stage"
	},
	"versionSync": [
		{
			"file": "lafka-plugin.php",
			"pattern": "^\\s*Version:\\s*(\\d+\\.\\d+\\.\\d+[^\\s]*)",
			"flags": "m",
			"required": true
		},
		{
			"file": "readme.txt",
			"pattern": "^Stable tag:\\s*(\\d+\\.\\d+\\.\\d+[^\\s]*)",
			"flags": "m",
			"required": true
		},
		{
			"file": "languages/lafka-plugin.pot",
			"pattern": "^\"Project-Id-Version: Lafka Plugin (\\d+\\.\\d+\\.\\d+[^\\\\\\s]*)",
			"flags": "m",
			"required": true
		}
	],
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@wordpress/stylelint-config": "^26.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"stylelint": "^17.16.0"
	}
}
