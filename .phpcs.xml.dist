<?xml version="1.0"?>
<ruleset name="Lafka Plugin">
	<description>WordPress coding standards for Lafka Plugin</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Show progress and sniff codes in all reports -->
	<arg value="ps"/>

	<!-- Speed: sniff files in parallel, and skip files unchanged since the last
	     run (cache keyed on file content + ruleset; git-ignored, restored by
	     actions/cache in CI). -->
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs.cache"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<!-- Strip the filepaths down to the relevant bit -->
	<arg name="basepath" value="."/>

	<!-- Rules: WordPress-Extra, no excludes. Warnings fail the run too. -->
	<rule ref="WordPress-Extra"/>

	<!-- lafka_llms_escape_text() escapes the machine-readable documents
	     (text/plain, markdown, JSON) for their own formats; HTML escaping
	     would corrupt them. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customEscapingFunctions" type="array">
				<element value="lafka_llms_escape_text"/>
			</property>
		</properties>
	</rule>

	<!-- WooCommerce capabilities the plugin checks (not WordPress core caps). -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="edit_shop_orders"/>
				<element value="order_again"/>
				<element value="view_order"/>
				<element value="manage_product_terms"/>
			</property>
		</properties>
	</rule>

	<!-- Plugin nonce verifiers: calls to these count as nonce verification. -->
	<rule ref="WordPress.Security.NonceVerification">
		<properties>
			<property name="customNonceVerificationFunctions" type="array">
				<element value="lafka_verify_term_form_nonce"/>
				<element value="lafka_verify_checkout_nonce"/>
				<element value="lafka_verify_order_review_nonce"/>
			</property>
		</properties>
	</rule>

	<!-- Request-input sanitization: added explicitly because WordPress-Extra omits it. -->
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<properties>
			<!-- Plugin sanitizers for already-unslashed input: a capped text line,
			     a clamped integer, the FAQ repeater (text question, kses answer),
			     the last-order cookie parser that rejects any payload whose
			     fields are not the types the plugin writes, and the map-pin parser
			     that returns two range-checked floats or null. -->
			<property name="customSanitizingFunctions" type="array">
				<element value="lafka_sanitize_category_tagline"/>
				<element value="lafka_sanitize_product_serves"/>
				<element value="lafka_sanitize_term_faq_rows"/>
				<element value="lafka_pdp_parse_last_order_cookie"/>
				<element value="lafka_parse_store_map_location"/>
			</property>
		</properties>
	</rule>

	<!-- Cross-version PHP compatibility against the PHP floor (the plugin header
	     is the single source for the floors). PHPCompatibility 10 (alpha) is
	     required: 9.3.5 has no PHP 8.x sniffs. -->
	<config name="testVersion" value="8.3-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- WordPress text domain. Every string uses 'lafka-plugin' — the
	     WordPress.WP.I18n.TextDomainMismatch sniff is enforced. -->
	<config name="text_domain" value="lafka-plugin"/>

	<!-- Minimum supported WordPress version (the WP floor in the plugin header) -->
	<config name="minimum_wp_version" value="7.0"/>

	<!-- Exclude third-party / vendor directories -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
</ruleset>
