<?xml version="1.0"?>
<ruleset name="Lafka Plugin">
	<description>WordPress coding standards for Lafka Plugin</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Show progress and sniff codes in all reports -->
	<arg value="ps"/>

	<!-- Speed: sniff files in parallel, and skip files unchanged since the last
	     run (cache keyed on file content + ruleset; git-ignored, restored by
	     actions/cache in CI). -->
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs.cache"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<!-- Strip the filepaths down to the relevant bit -->
	<arg name="basepath" value="."/>

	<!-- Rules: WordPress-Extra, no excludes. Warnings fail the run too. -->
	<rule ref="WordPress-Extra"/>

	<!-- Unique global prefixes (ThemeForest / WP.org requirement). -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="lafka"/>
				<element value="Lafka"/>
			</property>
		</properties>
	</rule>

	<!-- Plugin nonce verifiers: calls to these count as nonce verification. -->
	<rule ref="WordPress.Security.NonceVerification">
		<properties>
			<property name="customNonceVerificationFunctions" type="array">
				<element value="lafka_verify_term_form_nonce"/>
			</property>
		</properties>
	</rule>

	<!-- Cross-version PHP compatibility against the PHP floor (COMPATIBILITY.md
	     is the single source for the floors). PHPCompatibility 10 (alpha) is
	     required: 9.3.5 has no PHP 8.x sniffs. -->
	<config name="testVersion" value="8.3-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- WordPress text domain. Every string uses 'lafka-plugin' — the
	     WordPress.WP.I18n.TextDomainMismatch sniff is enforced. -->
	<config name="text_domain" value="lafka-plugin"/>

	<!-- Minimum supported WordPress version (the WP floor in COMPATIBILITY.md) -->
	<config name="minimum_wp_version" value="7.0"/>

	<!-- Exclude third-party / vendor directories -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
</ruleset>
