#!/usr/bin/env bash
#
# Pre-push hook for lafka-plugin: runs every CI gate (version SSOT, PHP
# syntax, PHPCS, ESLint, Stylelint, .min.js freshness) on every push, the
# independent ones in parallel. Lint caches keep unchanged files fast.
# Nothing is optional: a missing dependency fails the push.
#
# Install (one-time per clone):
#     git config core.hooksPath .githooks
#

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

red()   { printf '\033[31m%s\033[0m\n' "$1"; }
green() { printf '\033[32m%s\033[0m\n' "$1"; }
blue()  { printf '\033[36m%s\033[0m\n' "$1"; }

[ -d node_modules ] || { red "✖ pre-push: node_modules missing — run: npm ci"; exit 1; }
[ -d vendor ] || { red "✖ pre-push: vendor missing — run: composer install"; exit 1; }

blue "▸ pre-push: version SSOT"
npm run check-version --silent || { red "✖ pre-push: version check FAILED"; exit 1; }

logdir=$(mktemp -d)
trap 'rm -rf "$logdir"' EXIT
pids=()
names=()
run() { # run <name> <command...> in the background, output to a log
	local name=$1
	shift
	blue "▸ pre-push: $name"
	( "$@" > "$logdir/$name.log" 2>&1 ) &
	pids+=($!)
	names+=("$name")
}

run php-syntax composer lint:php --quiet
run phpcs composer phpcs --quiet
run eslint npm run lint:js --silent
run stylelint npm run lint:css --silent
run min-build sh -c 'npm run build --silent > /dev/null && git diff --exit-code -- "*.min.js"'

failed=0
for i in "${!pids[@]}"; do
	if ! wait "${pids[$i]}"; then
		red "✖ pre-push: ${names[$i]} FAILED"
		tail -20 "$logdir/${names[$i]}.log"
		failed=1
	fi
done

if [ "$failed" = 1 ]; then
	red "   fix the failing gates above, then push again"
	exit 1
fi

green "✓ pre-push: all gates passed"
