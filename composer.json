{
	"name": "lafka/lafka-plugin",
	"description": "Lafka Companion Plugin",
	"type": "wordpress-plugin",
	"require": {
		"php": "^8.1"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.3",
		"phpcompatibility/phpcompatibility-wp": "^3.0.0-alpha2@alpha",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^12.0",
		"brain/monkey": "^2.7",
		"phpcompatibility/php-compatibility": "^10.0.0-alpha2@alpha",
		"phpcompatibility/phpcompatibility-paragonie": "^2.0.0-alpha2@alpha"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.3"
		}
	},
	"scripts": {
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"test": "phpunit"
	}
}
