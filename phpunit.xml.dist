<?xml version="1.0"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
	bootstrap="tests/bootstrap.php"
	cacheDirectory=".phpunit.cache"
	executionOrder="defects"
	colors="true"
	failOnDeprecation="true"
	failOnWarning="true"
	failOnRisky="true"
	beStrictAboutOutputDuringTests="true"
>
	<extensions>
		<!-- Every function a test stubs is defined up front, so function_exists() answers the same in any test order. -->
		<bootstrap class="LafkaPlugin\Tests\Unit\Support\LeftoverStubsExtension"/>
	</extensions>
	<testsuites>
		<testsuite name="unit">
			<directory>tests/Unit</directory>
		</testsuite>
	</testsuites>
</phpunit>
